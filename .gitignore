# ==============================================================================
# 🎯 Flutter Production .gitignore Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flutter & Dart Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
/build/
ephemeral/

# Document & API Docs
# **/doc/api/

# Test Coverage
coverage/
*.lcov
lcov.info

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 2. Secrets, Keystores & Environment Files
# ------------------------------------------------------------------------------
# Environment Variables
.env
.env.*
!.env.example

# Android Keystores & Properties
key.properties
*.jks
*.keystore
*.p12
*.pem
*.cer

# iOS Provisioning & Certificates
*.mobileprovision
*.cer
*.certSigningRequest
*.p12

# Service Accounts & Firebase Credentials (Private Keys)
google-services.json
GoogleService-Info.plist
firebase_credentials.json
service-account*.json
secrets.json

# ------------------------------------------------------------------------------
# 3. Android Platform Specifics
# ------------------------------------------------------------------------------
# Local Android SDK configuration
android/local.properties
android/.gradle/
android/captures/
android/gradle-app.setting
android/app/debug/
android/app/profile/
android/app/release/
android/app/build/
android/build/
android/.idea/

# Android Build Outputs
*.apk
*.aab

# ------------------------------------------------------------------------------
# 4. iOS & macOS Platform Specifics
# ------------------------------------------------------------------------------
# CocoaPods
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/.symlinks/
**/ios/Flutter/.last_build_id
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/Generated.xcconfig
**/macos/Flutter/flutter_export_environment.sh

# Xcode
**/DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.ipa

# ------------------------------------------------------------------------------
# 5. Windows & Linux Platform Specifics
# ------------------------------------------------------------------------------
# Windows
windows/flutter/ephemeral/
windows/build/
*.exe
*.dll
*.obj
*.pdb

# Linux
linux/flutter/ephemeral/
linux/build/
*.so

# Web
web/build/

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ IDEA, Android Studio)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text / Fleet / Eclipse
*.sublime-project
*.sublime-workspace
.fleet/
.project
.classpath

# ------------------------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 8. Local Databases & Logs
# ------------------------------------------------------------------------------
*.log
*.sqlite
*.db
*.hive
*.lock.db
.history/
.temp/
.tmp/
